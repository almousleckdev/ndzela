# Copy to .env (git-ignored) and fill in. Generate keys with openssl.
JWT_SECRET=                # openssl rand -base64 48
MFA_ENCRYPTION_KEY=        # openssl rand -base64 32  (losing it makes stored MFA seeds unreadable)
MAIL_USERNAME=
MAIL_PASSWORD=             # SMTP / app password
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=    # only used when that user does not exist yet
# Optional
# Behind a reverse proxy: native (so rate limits and the audit trail see the visitor). Direct exposure: none.
FORWARD_HEADERS_STRATEGY=none
COOKIE_SECURE=false        # true when served over HTTPS
SWAGGER_ENABLED=false
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
# The public website: may only post to /api/v1/public, never with the cookie
PUBLIC_SITE_ORIGINS=http://localhost:3001
MAIL_PROVIDER=smtp       # smtp | resend | log (log prints OTP/reset links to the console, local dev only)
RESEND_API_KEY=          # when MAIL_PROVIDER=resend
MAIL_FROM=NDZela Admin <onboarding@resend.dev>
# PVit mobile money (sandbox values come from the PVit merchant space; the code_url values are the "Code URL" of each API)
PVIT_BASE_URL=https://api.mypvit.pro
PVIT_OPERATION_ACCOUNT_CODE=   # test operation account, starts with ACC_
PVIT_SECRET_PASSWORD=          # password defined for the "Renew secret" API
PVIT_CODE_URL_SECRET=
PVIT_CODE_URL_PAYMENT=
PVIT_CODE_URL_STATUS=
PVIT_CODE_URL_FEES=
PVIT_CODE_URL_KYC=
PVIT_CODE_URL_BALANCE=
PVIT_CALLBACK_URL_CODE=        # code of the public HTTPS Callback URL (localhost is refused)
PVIT_AGENT=NDZELA
PVIT_PRODUCT=LOYER
PVIT_OWNER_CHARGE=CUSTOMER     # CUSTOMER: the driver pays the fee on top | MERCHANT: NDZELA absorbs it
PVIT_SANDBOX_AMOUNT=           # sandbox only: PVit succeeds below 1000 XAF, so a fixed test amount (e.g. 150) is collected instead of the arrears; empty in production

# OCPP charging platform (Zella)
OCPP_BASE_URL=https://zella-ocpp.com
OCPP_API_KEY=                  # X-API-Key of the Partner API, sent by the OCPP engineer
OCPP_WEBHOOK_SECRET=           # shared secret their webhooks carry; webhooks are refused while it is empty
OCPP_WEBHOOK_HEADER=X-Webhook-Secret
OCPP_COUNTRY=GA

# Cloudinary file storage (Cloudinary console > Settings > API Keys). The API secret stays in .env only, never in the repo, the frontend or logs.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Root folder of this environment: every file lives under <root>/<country code>/..., e.g. ndzela-dev, ndzela-prod
CLOUDINARY_ROOT_FOLDER=ndzela-dev

# OCPP Fleet read-only API key (GRANTED + READ, scoped to the chargers granted to us). Never commit a real value.
OCPP_FLEET_API_KEY=
# OCPP sync (optional)
# OCPP_SYNC_ENABLED=true
# OCPP_SYNC_INTERVAL=PT1M
